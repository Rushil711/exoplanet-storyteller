# auto: use Ollama when it answers, otherwise replay recorded Gemma stories.
# ollama: require Ollama. offline: only the recorded stories.
LLM_BACKEND=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_FAST_MODEL=gemma3:1b
OLLAMA_TIMEOUT=240
STORY_MAX_RETRIES=2

# xAI Grok Imagine and xAI Voice. Read only on the server. Leave blank for mock mode.
XAI_API_KEY=
# auto: mock when XAI_API_KEY is empty. 1 forces mock. 0 forces the real API.
APP_MOCK_MEDIA=auto
XAI_BASE_URL=https://api.x.ai/v1
XAI_IMAGE_MODEL=grok-imagine-image
XAI_VOICE_ID=eve
XAI_TIMEOUT=90

# 1: never call the NASA TAP service; use the bundled catalog snapshot only.
ARCHIVE_OFFLINE=0
TAP_TIMEOUT=30

# Optional. Defaults are .cache/ and logs/harness.jsonl under the repo root.
# CACHE_DIR=
# LOG_FILE=
